ddcot091 comparetotal -9.99999999E+384 9.99999999E+384  -> -1
ddcot092 comparetotal  9.99999999E+384 -9.99999999E+384 -> 1
ddcot093 comparetotal -9.99999999E+384 -9.99999999E+384 -> 0

