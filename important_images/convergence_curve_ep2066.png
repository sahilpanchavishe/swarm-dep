<stringTable xmlns="http://schemas.microsoft.com/windows/2008/deviceExperienceResources">
  <string id="LTOOLS_CATEGORY_NAME">Lenovo Tools</string>
  <string id="LTOOLS_CATEGORY_DESC">נהלו את מערכת Lenovo שלכם באמצעות תוכנת.</string>
  <string id="LTOOLS_CATEGORY_TIP">תוכנת Lenovo מספקת כלי מחלקת עסקים לשימוש יומיומי.</string>
  <string id="ATHEN_AND_FPR_TASK_NAME">השתמשו ב-Lenovo Fingerprint Software להוספת בטיחות ונוחות.</string>
  <string id="FPR_TASK_NAME">קורא טביעות אצבע</string>
  <string id="FPR_TASK_DESC">השתמשו ב-Lenovo Fingerprint Software להוספת בטיחות ונוחות.</string>
  <string id="ATHFPR_TASK_NAME">‏Notebook Fingerprint Reader‏</string>
  <string id="SYSUPD_TASK_NAME">עדכון ומנהלי התקן</string>
  <string id="SYSUPD_TASK_DESC">‏Lenovo ThinkVantage System Update מחפש אחר עדכוני התוכנה ומנהל ההתקן העדכניים ביותר.</string>
  <string id="TOOLBOX_TASK_NAME">תקינות מערכת ותכניות אבחון</string>
  <string id="TOOLBOX_TASK_DESC">‏Lenovo ThinkVantage Toolbox עוקבת אחר תקינות המערכת ומיידעת אתכם אודותיה.</string>
  <string id="RNR_TASK_NAME">גיבוי ושחזור משופרים</string>
  <string id="RNR_TASK_DESC">‏Lenovo ThinkVantage Rescue and Recovery יכולה לגבות את כל ההגדרות והנתונים שלכם בהתקני אחסון מקומיים או חיצוניים.</string>
  <string id="PWD_TASK_NAME">מאגר סיסמאות</string>
  <string id="PWD_TASK_DESC">‏Lenovo ThinkVantage Password Manager זוכר את הסיסמאות שלכם עבורכם.</string>
  <string id="PWRMGR_TASK_NAME">פקדי הפעלה</string>
  <string id="PWRMGR_TASK_DESC">‏Lenovo ThinkVantage Power Manager מאפשר לכם למטב את ניצול האנרגיה.</string>
  <string id="AC_TASK_NAME">חיבורי אינטרנט</string>
  <string id="AC_TASK_DESC">‏Lenovo ThinkVantage Access Connections מאפשר לכם להתחבר ולנהל רשתות אלחוטיות.</string>
  <string id="MBC_TASK_NAME">‏3G Mobile Broadband‏</string>
  <string id="MBC_TASK_DESC">‏Lenovo ThinkVantage Mobile Broadband Activate מסייע לכם להישאר מחוברים באמצעות חיבור אלחוטי ברחבי העולם.</string>
  <string id="GPS_TASK_NAME">‏GPS</string>
  <string id="GPS_TASK_DESC">משלב בין Lenovo ThinkVantage GPS ובין יישומי GPS‏.</string>
  <string id="APS_TASK_NAME">הגנת כרית אוויר</string>
  <string id="APS_TASK_DESC">‏Lenovo ThinkVantage Active Protection System פועלת כמו כר מתכוונן עבור הכונן הקשיח שלכם.</string>
  <string id="RECOV_TASK_NAME">תקליטורי Factory Recovery‏</string>
  <string id="RECOV_TASK_DESC">השתמשו ב-Lenovo ThinkVantage Recovery Media כדי לשמור עותק של תמונת הטעינה המוקדמת במפעל בכונן חיצוני או במדיה אופטית.</string>
  <string id="TVTDWN_TASK_NAME">הורדת Lenovo Tools‏</string>
  <string id="TVTDWN_TASK_DESC">תוכנת Lenovo מספקת כלי מחלקת עסקים לשימוש יומיומי.</string>
