            .next-flipper {
                left: 1px;
                right: auto;
            }

            :host slot.panels::slotted([hidden]) {
                left: -100%;
            }

            :host slot.panels::slotted(.unload-left),
            :host slot.panels::slotted(.load-right) {
                left: 100%;
            }

            :host slot.panels::slotted(.unload-right) {
                left: -100%;
            }

            @keyframes loading {
                0% {
                    background-position: -100% 0;
                }
                100% {
                    background-position: 0 0;
                }
            }
